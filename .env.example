# Frontend (apps/web) — exposed to the browser. Never put secrets here.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_PICKER_APP_ID=
VITE_BACKEND_BASE_URL=http://localhost:8787

# Backend (apps/worker) — set as Wrangler secrets in production.
# Run `npx wrangler secret put <NAME>` for each.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
TOKEN_VAULT_KEY=                 # 32-byte base64-encoded AES-GCM key
ALLOWED_FRONTEND_ORIGINS=http://localhost:5173
